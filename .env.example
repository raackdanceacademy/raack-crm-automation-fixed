PORT=3001
SPREADSHEET_ID=your_google_sheet_id_here

# No AI key is needed anymore — message parsing is now a strict,
# deterministic format check (see services/messageParser.js), not an
# AI classification call. This is faster and more reliable under load,
# and it's what stops garbage/"N/A" rows from ever being logged.

# WAHA Integration Settings
WAHA_API_URL=your_waha_api_url_here
WAHA_API_KEY=your_waha_api_key_here

# The single WhatsApp NUMBER (digits only, country code + number, no "+",
# no "@c.us") that issues are DM'd to. Different users/counsellors can send
# from different numbers — this just makes sure we only log messages that
# landed on OUR business number. Leave blank to skip this extra check.
TARGET_NUMBER=your_business_whatsapp_number_here

# IMGBB is used to host issue screenshots so a public link can go in the sheet.
IMGBB_API_KEY=your_imgbb_api_key_here

# Google Drive folder ID (shared with the service account as Editor) where
# uploaded issue screenshots are stored.
DRIVE_FOLDER_ID=your_drive_folder_id_here


# ── Catch-up of messages received while the server / Docker was OFF ──
# All optional. The defaults below work without adding anything to .env.
# WAHA session name (the "default" in /api/files/default/...)
WAHA_SESSION=default
# Set to false to switch the catch-up off completely.
CATCHUP_ENABLED=true
# Only used the very first time (no data/state.json yet): how many hours back to look.
CATCHUP_LOOKBACK_HOURS=72
# Safety-net re-check while the server is running.
CATCHUP_INTERVAL_MINUTES=15
